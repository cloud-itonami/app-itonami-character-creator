{:paths ["src"]
 ;; west checks this repo out as a sibling of orgs/kotoba-lang/{org-vrmc-vrm,character}
 ;; (orgs/kotoba-lang/kami-app-character-creator/), so relative :local/root resolves.
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba"
         :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba"
         :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba"
         :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/org-vrmc-vrm
        {:git/url "https://github.com/kotoba-lang/kotoba"
         :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
         :deps/root "lib/org.vrmC.vrm"}
        io.github.kotoba-lang/character
        {:git/url "https://github.com/kotoba-lang/kotoba"
         :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
         :deps/root "lib/kotoba.character"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :override-deps {
                                  io.github.kotoba-lang/bytes
                                  {:git/url "https://github.com/kotoba-lang/kotoba"
                                   :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                                   :deps/root "lib/kotoba.bytes"}
                                  io.github.kotoba-lang/character
                                  {:git/url "https://github.com/kotoba-lang/kotoba"
                                   :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                                   :deps/root "lib/kotoba.character"}
                                  io.github.kotoba-lang/edn
                                  {:git/url "https://github.com/kotoba-lang/kotoba"
                                   :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                                   :deps/root "lib/kotoba.edn"}
                                  io.github.kotoba-lang/glb
                                  {:git/url "https://github.com/kotoba-lang/kotoba"
                                   :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                                   :deps/root "lib/org.khronos.glb"}
                                  io.github.kotoba-lang/org-vrmc-vrm
                                  {:git/url "https://github.com/kotoba-lang/kotoba"
                                   :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                                   :deps/root "lib/org.vrmC.vrm"}
                                  io.github.kotoba-lang/spec
                                  {:git/url "https://github.com/kotoba-lang/kotoba"
                                   :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                                   :deps/root "lib/kotoba.spec"}
                                  io.github.kotoba-lang/test
                                  {:git/url "https://github.com/kotoba-lang/kotoba"
                                   :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                                   :deps/root "lib/kotoba.test"}
                                  io.github.kotoba-lang/text
                                  {:git/url "https://github.com/kotoba-lang/kotoba"
                                   :git/sha "ee75001ee44a9b793602d1549e5e977c4562a5fe"
                                   :deps/root "lib/kotoba.text"}
                  }}
           ;; Phase 2 (ADR-2607031200) preview-demo.html build only. `../webgpu`
           ;; is `kotoba.lang/webgpu`'s `kami.webgpu.mesh` (skin/morph executor) —
           ;; a dev-only dep, not part of the pipeline's :deps (which stays
           ;; browser/JVM-portable, no GPU/cljs dependency).
           :cljs {:extra-paths ["dev"]
                  :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                               io.github.kotoba-lang/webgpu {:local/root "../webgpu"}}
                  :main-opts ["-m" "cljs.main" "-co" "dev/build.edn" "-c" "character-creator.preview-demo"]}
           ;; /loop maturity pass — the real interactive character-creation screen
           ;; (`app.html`/`character-creator.app`), same dev-only shape as `:cljs`
           ;; above plus `kami-engine-app-sdk` (renamed from `kami-ui-sdk`, see
           ;; com-junkawasaki/root ADR-2607051200; namespace stays
           ;; `kami-ui-sdk.widgets`'s real DOM slider/color-swatch/carousel).
           :cljs-app {:extra-paths ["dev"]
                      :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                   io.github.kotoba-lang/webgpu {:local/root "../webgpu"}
                                   io.github.kotoba-lang/kami-engine-app-sdk {:local/root "../kami-engine-app-sdk"}}
                      :main-opts ["-m" "cljs.main" "-co" "dev/app-build.edn" "-c" "character-creator.app"]}
           ;; /loop maturity pass — procedural material patterns (kami.webgpu.mesh's
           ;; new color_b/pattern_kind/pattern_params uniform): a flat-vs-gradient
           ;; side-by-side proof for pattern-demo.html, same dev-only shape as :cljs.
           :cljs-pattern {:extra-paths ["dev"]
                          :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                       io.github.kotoba-lang/webgpu {:local/root "../webgpu"}}
                          :main-opts ["-m" "cljs.main" "-co" "dev/pattern-build.edn" "-c" "character-creator.pattern-demo"]}
           ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
           :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
                  :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                              "--fail-level" "error"]}}}